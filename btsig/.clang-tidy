# Annex K memcpy_s and memset_s are optional and this libc does not provide them.
# The copies are sizeof a local object, or a length the caller already checked.
Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  -performance-enum-size,
  portability-*,
  misc-*,
  -misc-include-cleaner,
  -misc-const-correctness,
  readability-braces-around-statements,
  readability-redundant-control-flow,
  readability-isolate-declaration,
  readability-simplify-boolean-expr

WarningsAsErrors: '*'

HeaderFilterRegex: '.*/(btsig|examples/characteristic_api)/.*'

CheckOptions:
  - key: bugprone-signed-char-misuse.CharTypdefsToIgnore
    value: 'int8_t'
