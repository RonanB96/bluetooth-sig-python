{
  "$ref": "#/$defs/IrDocument",
  "$defs": {
    "IrDocument": {
      "title": "IrDocument",
      "description": "One self-contained characteristic document.",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer"
        },
        "identifier": {
          "type": "string"
        },
        "uuid": {
          "type": "integer"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScalarField"
          }
        }
      },
      "required": [
        "schema_version",
        "identifier",
        "uuid",
        "provenance",
        "fields"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "title": "Provenance",
      "description": "Trace from the document back to the SIG YAML file.",
      "type": "object",
      "properties": {
        "source_path": {
          "type": "string"
        },
        "source_identifier": {
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "source_identifier"
      ],
      "additionalProperties": false
    },
    "ScalarField": {
      "title": "ScalarField",
      "description": "One resolved field in wire order.\n\n    Integer, boolean, and real fields store a raw ``minimum`` and ``maximum``.\n    A UTF-8 field stores ``0`` for both. ``utf8_capacity`` is the ``utf8s{N}``\n    octet maximum; a variable ``utf8s`` omits it. ``enumerators`` is empty unless\n    ``value_set`` is ``enumeration`` or ``flags``.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "wire_type": {
          "$ref": "#/$defs/WireType"
        },
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        },
        "transform": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Transform"
            }
          ],
          "default": null
        },
        "unit": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/UnitRef"
            }
          ],
          "default": null
        },
        "sentinels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sentinel"
          },
          "default": []
        },
        "utf8_capacity": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ],
          "default": null
        },
        "enumerators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Enumerator"
          },
          "default": []
        },
        "value_set": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ValueSet"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "wire_type",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false
    },
    "WireType": {
      "title": "WireType",
      "description": "Fixed-width wire types named by ADR-0003.\n\n    Boolean widths are bitfields stored as unsigned integers. ``medfloat16``,\n    ``medfloat32``, and ``float32`` store the little-endian bit pattern; the\n    generated member is the decoded ``double``.",
      "enum": [
        "boolean16",
        "boolean24",
        "boolean32",
        "boolean8",
        "float32",
        "medfloat16",
        "medfloat32",
        "sint16",
        "sint24",
        "sint32",
        "sint8",
        "uint1",
        "uint16",
        "uint2",
        "uint24",
        "uint32",
        "uint48",
        "uint64",
        "uint8",
        "utf8"
      ]
    },
    "Transform": {
      "title": "Transform",
      "description": "Exact transform: decoded = raw * coefficient * 10^decimal_exponent * 2^binary_exponent.",
      "type": "object",
      "properties": {
        "coefficient": {
          "type": "integer",
          "default": 1
        },
        "decimal_exponent": {
          "type": "integer",
          "default": 0
        },
        "binary_exponent": {
          "type": "integer",
          "default": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "UnitRef": {
      "title": "UnitRef",
      "description": "Assigned unit joined onto a field.",
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string"
        },
        "uuid": {
          "type": "integer"
        }
      },
      "required": [
        "identifier",
        "uuid"
      ],
      "additionalProperties": false
    },
    "Sentinel": {
      "title": "Sentinel",
      "description": "One raw sentinel and its meaning.",
      "type": "object",
      "properties": {
        "raw_value": {
          "type": "integer"
        },
        "meaning": {
          "$ref": "#/$defs/SentinelMeaning"
        }
      },
      "required": [
        "raw_value",
        "meaning"
      ],
      "additionalProperties": false
    },
    "SentinelMeaning": {
      "title": "SentinelMeaning",
      "description": "Sentinel meanings defined for this schema version.",
      "enum": [
        "not_known",
        "not_valid"
      ]
    },
    "Enumerator": {
      "title": "Enumerator",
      "description": "One named constant stored in a field.\n\n    An enumeration stores the raw code. A flags set stores the single-bit mask.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "ValueSet": {
      "title": "ValueSet",
      "description": "How a field's named constants combine.\n\n    ``enumeration`` is one code. ``flags`` is a set of independent bits.",
      "enum": [
        "enumeration",
        "flags"
      ]
    }
  }
}
